<Application x:Class="BudG.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:BudG.UI"
              Startup="Application_Startup" DispatcherUnhandledException="Application_DispatcherUnhandledException">
    <Application.Resources>
        
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

                <!-- This new dictionary holds the custom font style. -->
                <ResourceDictionary>
                    <Style x:Key="RobotoBold" TargetType="Control">
                        <Setter Property="FontFamily" Value="/BudG.UI;component/Fonts/Roboto-Bold.ttf#Roboto"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>

                    <Style x:Key="RobotoMedium" TargetType="Control">
                        <Setter Property="FontFamily" Value="/BudG.UI;component/Fonts/Roboto-Medium.ttf#Roboto"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                    </Style>

                    <Style x:Key="RobotoRegular" TargetType="Control">
                        <Setter Property="FontFamily" Value="/BudG.UI;component/Fonts/Roboto-Regular.ttf#Roboto"/>
                        <Setter Property="FontWeight" Value="Regular"/>
                    </Style>

                    <Style x:Key="RobotoSemiBold" TargetType="Control">
                        <Setter Property="FontFamily" Value="/BudG.UI;component/Fonts/Roboto-SemiBold.ttf#Roboto"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style x:Key="MyCustomHeadlineStyle" 
                           TargetType="TextBlock" 
                           BasedOn="{StaticResource MaterialDesignHeadline3TextBlock}">

                        <Setter Property="FontFamily" Value="/BudG.UI;component/Fonts/Roboto-Bold.ttf#Roboto"/>
                    </Style>
                    <Style x:Key="MyCustomBodylineStyle" 
        TargetType="TextBlock" 
        BasedOn="{StaticResource MaterialDesignBody1TextBlock}">

                        <Setter Property="FontFamily" Value="/BudG.UI;component/Fonts/Roboto-Regular.ttf#Roboto"/>
                    </Style>
                </ResourceDictionary>

                <ResourceDictionary>
                    <SolidColorBrush x:Key="PrimaryColor" Color="#1F41BB"/>
                    <SolidColorBrush x:Key="SecondaryColor" Color="#7C8386"/>
                    <SolidColorBrush x:Key="Background" Color="#F5F8FD"/>
                    <SolidColorBrush x:Key="White" Color="#F6F6F7"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#1C2128"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#5A6474"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#E0E6F0"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#4A76FF"/>
                    <SolidColorBrush x:Key="PressedBrush" Color="#1A42A8"/>

                </ResourceDictionary>
                <ResourceDictionary Source="ResourceDictianary/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="ResourceDictianary/CompoBoxStyle.xaml"/>
                <ResourceDictionary Source="ResourceDictianary/PasswordBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Page x:Class="BudG.UI.Pages.ForgetPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BudG.UI.Pages"
       xmlns:UserControl="clr-namespace:BudG.UI.Views"
  xmlns:ViewModels="clr-namespace:BudG.UI.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ForgetPasswordPage">

    <Page.Resources>
        <Storyboard x:Key="SlideIn">
            <ThicknessAnimation Duration="0:0:.50"
                         Storyboard.TargetProperty="Margin"
                         From="300,0,-500,0"
                         To="0"
                         DecelerationRatio=".9" />
        </Storyboard>
        <Storyboard x:Key="SlideOut">
            <ThicknessAnimation Duration="0:0:.5"
                         Storyboard.TargetProperty="Margin"
                         To="-500,0,500,0"
                         AccelerationRatio=".9" />
        </Storyboard>

        <DataTemplate DataType="{x:Type ViewModels:NotificationViewModel}">
            <UserControl:NotificationView/>
        </DataTemplate>

    </Page.Resources>


    <Grid x:Name="ForgetPasswordGrid">
        
    </Grid>
</Page>

<UserControl x:Class="BudG.UI.Views.CheckEmail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:custom="clr-namespace:ValidationTextBox;assembly=ValidationTextBox"

             xmlns:local="clr-namespace:BudG.UI.Views"
             mc:Ignorable="d" 
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             >
    <Grid x:Name="Header">

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="2" Text="Forgot your Password" Foreground="{StaticResource TextPrimary}"  
                   TextAlignment="Center" Style="{StaticResource MyCustomHeadlineStyle}"/>

        <!-- Subtitle -->
        <TextBlock Grid.Row="3" FontSize="18" Foreground="{StaticResource TextSecondary}" 
                   Text="Enter your registered email to reset your password." 
                   TextAlignment="Center" Style="{DynamicResource MyCustomBodylineStyle}" />

        <!-- Email Input -->
        <custom:TextBoxValidation Grid.Row="5" Height="60" Width="400" FontSize="18" 
                 Foreground="{StaticResource TextPrimary}"
                 materialDesign:HintAssist.Hint="Email Address" 
                 BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}"
                 materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource BorderBrush}"
                
                 Style="{StaticResource MaterialDesignOutlinedTextBox}">
        </custom:TextBoxValidation>

        <!-- Reset Button -->
        <Button x:Name="ResetPasswordButton" Content="Check the email" 
                Background="#FF0099CC"
                materialDesign:ButtonAssist.CornerRadius="10" 
                BorderBrush="{StaticResource BorderBrush}"
                Grid.Row="7" Width="400" Height="50"
                
                Style="{DynamicResource MaterialDesignFlatDarkBgButton}"/>

        <!-- Info Text (Check Email) -->
       

        <!-- Back to Login Link -->
        <TextBlock Grid.Row="9" FontSize="20" TextAlignment="Center"
                   Foreground="{StaticResource PrimaryColor}"  
                   HorizontalAlignment="Left" Margin="50 0 0 0"
                   Style="{DynamicResource MaterialDesignBody1TextBlock}">
            <Hyperlink Command="{Binding BackToLoginCommand}" Foreground="{StaticResource SecondaryColor}">
                <Run Text="Back to Sign in"/>
            </Hyperlink>
        </TextBlock>

        <!-- Bottom Gradient -->
        <Border Grid.Row="13" Height="80" Grid.ColumnSpan="2">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFAAAAAA" Offset="1"/>
                    <GradientStop Color="#FFA8A4A4" Offset="0.757" />
                    <GradientStop Color="#ffffff" Offset="0.337"/>
                    <GradientStop Color="#FFE6E6E6" Offset="0.537"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
